# ========================================================
# Smart Campus Cloud Management System - Environment Variables
# ========================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_campus_db
DB_USER=root
DB_PASSWORD=rootpassword
MYSQL_ROOT_PASSWORD=rootpassword

# Backend Server Configuration
SERVER_PORT=8080

# Spring Security & JWT Configuration
# Generate a unique secret for each environment (for example: openssl rand -hex 32)
JWT_SECRET=replace-with-a-generated-64-character-hex-secret
JWT_EXPIRATION_MS=900000

# Frontend Configuration
VITE_API_URL=http://localhost:8080
